# Caddy reverse proxy for public (TLS) deployments: `docker compose --profile tls up -d`
#
# Terminates HTTPS/WSS for the LiveKit server. Requires VA_DOMAIN in .env and
# DNS pointing at this host (ports 80/443 open). Caddy obtains certificates
# automatically via Let's Encrypt.
#
# Devices then connect with:  wss://<VA_DOMAIN>  (see scripts/token.py output)
#
# NOTE: for remote/internet deployments also configure TURN in
# livekit/livekit.yaml (see docs/deployment.md) so WebRTC media can relay
# through restrictive networks.

{$VA_DOMAIN} {
	# WebSocket + HTTP signaling to the host-networked LiveKit server
	reverse_proxy host.docker.internal:7880

	# Web console (configuration & diagnostics UI) under /console -
	# set UI_ROOT_PATH=/console in .env so the app generates matching URLs,
	# and OIDC_REDIRECT_URL=https://{$VA_DOMAIN}/console/auth/oidc/callback
	# when SSO is enabled.
	handle_path /console/* {
		reverse_proxy host.docker.internal:{$UI_PORT}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
	}
}
