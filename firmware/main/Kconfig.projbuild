menu "LiveKit Example"

    config LK_EXAMPLE_SERVER_URL
        string "LiveKit server URL"
        default "ws://192.168.0.29:7880"
        help
            WebSocket URL of the self-hosted LiveKit server. Use the LAN IP
            of the Docker host, never localhost (localhost is the device).

    config LK_EXAMPLE_TOKEN
        string "Room access token"
        default "PASTE_TOKEN_HERE"
        help
            Pre-minted access token (JWT) for this device. Mint one from the
            repo root with: make token ID=respeaker-1 ROOM=home
            The room name is encoded in the token, not set here.

endmenu
