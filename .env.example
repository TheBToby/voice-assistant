# ============================================================================
# Voice Assistant - environment configuration
# Copy to `.env` and fill in your values:   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# LiveKit server (self-hosted)
# These credentials are shared by the LiveKit server, the agent worker and the
# token generator. Pick ANY long random secret in production.
# ----------------------------------------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret

# URL the agent worker uses to reach LiveKit.
# Default docker-compose runs with host networking -> ws://localhost:7880
LIVEKIT_URL=ws://localhost:7880

# Hostname/IP the voice device (reSpeaker XVF3800) and browsers use to reach
# LiveKit. Used by `scripts/mint_token.py` only for printing convenience.
PUBLIC_LIVEKIT_WS_URL=ws://192.168.1.50:7880

# ----------------------------------------------------------------------------
# STT / TTS - ElevenLabs (https://elevenlabs.io -> profile -> API keys)
# ----------------------------------------------------------------------------
ELEVEN_API_KEY=your-elevenlabs-api-key

# STT model. scribe_v2_realtime = streaming (lowest latency), scribe_v1 = batch
STT_MODEL=scribe_v2_realtime

# TTS model + voice. Browse voices at https://elevenlabs.io/app/voices
TTS_MODEL=eleven_turbo_v2_5
# default voice: "JBFqnCBsd6RMkjVDRZzb" (George). Replace with your own voice id.
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ----------------------------------------------------------------------------
# LLM - OpenAI-compatible.
# OPENAI_BASE_URL lets you point at any OpenAI-compatible endpoint
# (Ollama: http://localhost:11434/v1, vLLM, LM Studio, OpenRouter, ...).
# ----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
#OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gpt-4.1-mini

# ----------------------------------------------------------------------------
# Assistant persona & built-in skills
# ----------------------------------------------------------------------------
ASSISTANT_NAME=Atlas
# Assistant language: spoken replies, the built-in skills (time, timers) and
# the default system prompt follow it. Supported: de (German, default), en.
LANGUAGE=de
# Where the assistant lives - used as the default location for weather queries.
# Leave empty to always ask for the location.
DEFAULT_LOCATION=Berlin
# metric or imperial
WEATHER_UNITS=metric
# Optional override of the full system prompt (see agent/config.py for default)
#ASSISTANT_INSTRUCTIONS=
# Optional first-boot greeting spoken when a session starts (empty = silent)
GREETING=Sprachassistent bereit.
# Turn-detection model improves natural conversation. The agent picks the
# English or German (multilingual) model automatically based on LANGUAGE;
# disable to skip the model download or for other languages. (true/false)
ENABLE_TURN_DETECTOR=true

# ----------------------------------------------------------------------------
# Home Assistant (via the official MCP Server integration)
# 1. Home Assistant -> Settings -> Devices & services -> Add Integration ->
#    "Model Context Protocol Server"
# 2. Create a long-lived access token: Profile -> Security -> Long-Lived Tokens
# 3. Set URL + token below. The agent appends /api/mcp automatically.
# Expose the entities you want the assistant to control:
#    Settings -> Voice assistants -> Expose.
# ----------------------------------------------------------------------------
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# ----------------------------------------------------------------------------
# MCP servers (JSON list) - e.g. weather or any other MCP server, without
# code changes. Example (a weather server of your choice + auth header):
# MCP_SERVERS_JSON=[{"id":"weather","url":"http://localhost:9000/mcp"},{"id":"music","url":"https://example.com/mcp","headers":{"Authorization":"Bearer xyz"}}]
# ----------------------------------------------------------------------------
MCP_SERVERS_JSON=

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
TZ=Etc/UTC
LOG_LEVEL=info

# Web test client port (static browser page served by nginx)
WEB_TEST_PORT=8080

# ----------------------------------------------------------------------------
# Persistent data locations
# Leave unset to use named Docker volumes (default). Set to an absolute path
# (or a ./relative path inside this repo) to bind-mount that host folder
# instead. Switching after first start does NOT migrate existing data - copy
# it first, e.g.:
#   docker run --rm -v voice-assistant_model-cache:/from -v /your/folder:/to \
#     alpine cp -a /from/. /to/
# ----------------------------------------------------------------------------
# Model downloads (silero VAD, turn detector); used by agent + smoke services
#MODEL_CACHE_DIR=
# Caddy TLS certificates / config (only used with the "tls" profile)
#CADDY_DATA_DIR=
#CADDY_CONFIG_DIR=
